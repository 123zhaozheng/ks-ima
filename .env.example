# Caddy/dev-proxy upstream for the Python API.
PYTHON_API_URL=http://localhost:8000
IMA_PUBLIC_ORIGIN=http://localhost:8080
IMA_CORS_ORIGINS=http://localhost:8080
IMA_ENVIRONMENT=development
IMA_BUILD_VERSION=dev
# Leave empty unless the Python API is private behind a known reverse proxy.
IMA_TRUSTED_PROXIES=
IMA_STORAGE_ENDPOINT=
IMA_STORAGE_REGION=us-east-1
IMA_STORAGE_BUCKET=
IMA_STORAGE_ACCESS_KEY_ID=
IMA_STORAGE_SECRET_ACCESS_KEY=
IMA_MODEL_KEY_RING={"v1":"replace-with-a-32-byte-model-key"}
IMA_MODEL_CURRENT_KEY_VERSION=v1
IMA_MODEL_FINGERPRINT_KEY=replace-with-a-high-entropy-fingerprint-key
IMA_MODEL_CUSTOM_CA_DIR=/run/secrets/model-ca
IMA_MODEL_ALLOWED_HOSTS=gateway.internal
IMA_MODEL_ALLOWED_CIDRS=
IMA_MODEL_ALLOW_INSECURE_PRIVATE=false
