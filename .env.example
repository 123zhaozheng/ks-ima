SITE_NAME="Nya AI"
FRONT_URL=http://localhost:9015
ADMIN_URL=http://localhost:9015
DATABASE_URL=postgres://user:password@localhost:5430/app
ZERO_CACHE_URL=http://localhost:4848
SERVER_URL=http://localhost:3000
PYTHON_API_INTERNAL_URL=http://localhost:8000
IMA_BRIDGE_TOKEN=replace-with-a-high-entropy-private-token
IMA_BRIDGE_TIMEOUT_MS=1500
IMA_MODEL_KEY_RING={"v1":"replace-with-a-32-byte-model-key"}
IMA_MODEL_CURRENT_KEY_VERSION=v1
IMA_MODEL_FINGERPRINT_KEY=replace-with-a-high-entropy-fingerprint-key
IMA_MODEL_CUSTOM_CA_DIR=/run/secrets/model-ca
IMA_MODEL_ALLOWED_HOSTS=gateway.internal
IMA_MODEL_ALLOWED_CIDRS=
IMA_MODEL_ALLOW_INSECURE_PRIVATE=false
ZERO_UPSTREAM_DB=$DATABASE_URL
ZERO_CHANGE_DB=postgres://user:password@localhost:5430/zero
ZERO_MUTATE_URL=$SERVER_URL/api/zero/mutate
ZERO_QUERY_URL=$SERVER_URL/api/zero/query
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_REPLICA_FILE="/tmp/sync-replica.db"

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
