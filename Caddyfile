{
  servers {
    trusted_proxies static 172.16.0.0/12
  }
}

:8080 {
	root * /srv/front

	@ima_health path /health/*
	handle @ima_health {
		reverse_proxy {$PYTHON_API_URL}
	}

	@ima_system path /api/v1/system/*
	handle @ima_system {
		reverse_proxy {$PYTHON_API_URL}
	}

	@ima_identity path /api/v1/auth/* /api/v1/account/* /api/v1/admin/*
	handle @ima_identity {
		reverse_proxy {$PYTHON_API_URL}
	}

	# The Python bridge is private Bun-to-API traffic, never a browser route.
	@ima_internal_forbidden path /api/v1/internal/*
	handle @ima_internal_forbidden {
		respond "Not Found" 404
	}

	@forbidden {
		path /api/admin* /api/zero*
	}
	handle @forbidden {
		respond "Forbidden" 403
	}

	@api path /api/*
	handle @api {
		reverse_proxy {$SERVER_URL}
	}

	handle_path /zero-cache* {
		reverse_proxy {$ZERO_CACHE_URL}
	}

	handle {
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}

:8081 {
	root * /srv/admin

	@ima_health path /health/*
	handle @ima_health {
		reverse_proxy {$PYTHON_API_URL}
	}

	@ima_system path /api/v1/system/*
	handle @ima_system {
		reverse_proxy {$PYTHON_API_URL}
	}

	@ima_identity path /api/v1/auth/* /api/v1/account/* /api/v1/admin/*
	handle @ima_identity {
		reverse_proxy {$PYTHON_API_URL}
	}

	@ima_internal_forbidden path /api/v1/internal/*
	handle @ima_internal_forbidden {
		respond "Not Found" 404
	}

	handle /api/zero* {
		respond "Forbidden" 403
	}

	@api path /api/*
	handle @api {
		reverse_proxy {$SERVER_URL}
	}

	handle_path /zero-cache* {
		reverse_proxy {$ZERO_CACHE_URL}
	}

	handle {
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
