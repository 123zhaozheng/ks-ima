{
  "name": "nyaai",
  "version": "0.0.1",
  "description": "All in one AI workspace",
  "productName": "Nya AI",
  "author": "NitroRCr <i@krytro.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "test": "bun test src src-server src-shared",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:all": "bun test src src-server src-shared && bun run test:unit",
    "test:permissions": "bun scripts/permission-smoke.ts",
    "test:mcp": "bun scripts/mcp-handshake.ts",
    "test:mcp-live": "bun scripts/mcp-live.ts",
    "dev:front": "TARGET_APP=front bun quasar dev",
    "dev:admin": "TARGET_APP=admin bun quasar dev",
    "dev:server": "bun run --hot src-server/index.ts",
    "build:front": "TARGET_APP=front bun quasar build -m pwa",
    "build:admin": "TARGET_APP=admin bun quasar build",
    "build:server": "bun build src-server/index.ts --target bun --minify --sourcemap --outdir ./dist/server",
    "dev:pg": "bun scripts/dev-pg.ts",
    "dev:db-up": "sudo docker compose -f ./dev-db/docker-compose.yml up -d",
    "dev:db-down": "sudo docker compose -f ./dev-db/docker-compose.yml down",
    "dev:db-rm": "source .env && bun dev:db-down && sudo docker volume rm -f dev-db_pgdata && rm -rf \"${ZERO_REPLICA_FILE}\"*",
    "generate:zero": "drizzle-zero generate -s src-server/schema/index.ts --format -o src-shared/schema.gen.ts",
    "generate:api": "bunx openapi-typescript frontend/generated/openapi.json -o src/api/generated/schema.ts",
    "test:e2e": "playwright test",
    "t": "bunx i18n t"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@ai-sdk/provider-utils": "^4.0.19",
    "@hono/zod-validator": "^0.7.6",
